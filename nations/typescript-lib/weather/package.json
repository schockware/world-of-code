{
  "name": "@world-of-code/weather",
  "version": "0.0.0",
  "description": "Weather domain core (quantities and units) in TypeScript. Population-free, zero runtime dependencies.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ucum": {
      "types": "./dist/ucum/index.d.ts",
      "default": "./dist/ucum/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "gen:ucum": "node scripts/gen-ucum.mjs",
    "check:ucum": "node scripts/gen-ucum.mjs --check"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
