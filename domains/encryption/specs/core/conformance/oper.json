    {
      "id": "precedence-operator-first",
      "requirements": ["ENC-OPER-009"],
      "operation": "prepare",
      "input": {"operator": "nope", "tokens": [{"bad": 1}]},
      "expect": {"outcome": "rejected", "reason": "operator.unknown"}
    },
    {
      "id": "precedence-first-faulty-token",
      "requirements": ["ENC-OPER-009"],
      "operation": "prepare",
      "input": {"operator": "classical-x", "tokens": [{"word": "ok"}, {"number": "x1"}, {"punct": "!"}]},
      "expect": {"outcome": "rejected", "reason": "operator.not-digits"}
    },
    {
      "id": "precedence-token-over-length",
      "requirements": ["ENC-OPER-009"],
      "operation": "prepare",
      "input": {"operator": "m209-army", "tokens": [{"word": ""}, {"punct": "!"}]},
      "expect": {"outcome": "rejected", "reason": "operator.unsupported-punctuation"}
    }
  ]
