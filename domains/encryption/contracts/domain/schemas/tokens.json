{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://world-of-code.example/encryption/domain/schemas/tokens.json",
  "title": "Tokens",
  "description": "The operator's marked-up message: what each piece is, and every word-break choice. The judgment (which words are names, which punctuation to keep, how to space) is already made; prepare only turns it into letters.",
  "type": "array",
  "items": {
    "oneOf": [
      {
        "type": "object",
        "required": [
          "word"
        ],
        "additionalProperties": false,
        "properties": {
          "word": {
            "type": "string",
            "pattern": "^[A-Za-z]+$",
            "not": {
              "pattern": "\n"
            },
            "description": "Letters A-Z in any case."
          }
        }
      },
      {
        "type": "object",
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z]+$",
            "not": {
              "pattern": "\n"
            },
            "description": "A proper name. Some operators mark names specially."
          }
        }
      },
      {
        "type": "object",
        "required": [
          "number"
        ],
        "additionalProperties": false,
        "properties": {
          "number": {
            "type": "string",
            "pattern": "^[0-9]+$",
            "not": {
              "pattern": "\n"
            },
            "description": "Digits, spelled out digit by digit."
          }
        }
      },
      {
        "type": "object",
        "required": [
          "punct"
        ],
        "additionalProperties": false,
        "properties": {
          "punct": {
            "type": "string",
            "minLength": 1,
            "description": "One punctuation mark. Each operator supports its own set."
          }
        }
      },
      {
        "type": "object",
        "required": [
          "gap"
        ],
        "additionalProperties": false,
        "properties": {
          "gap": {
            "type": "integer",
            "minimum": 0,
            "description": "How many separator letters go here. Each operator sets a maximum."
          }
        }
      }
    ]
  }
}
